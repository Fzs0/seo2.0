APP_NAME=seo-workbench-fastapi
APP_ENV=local
APP_PORT=8000

# 与 docker-compose.yml / docker run 一致
DATABASE_URL=postgresql+asyncpg://seo:seo_dev_local@localhost:5433/seo_workbench
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# 日志
LOG_LEVEL=INFO
LOG_JSON=true

# 规则引擎
RULE_AUTO_RELOAD_SECONDS=60

# AI provider（可选；缺失则所有 AI 阶段自动回退到本地 brief）
AI_KEYWORD_ANALYSIS_BASE_URL=
AI_KEYWORD_ANALYSIS_KEY=
AI_KEYWORD_ANALYSIS_MODEL=deepseek-chat
AI_BRIEF_GENERATION_BASE_URL=
AI_BRIEF_GENERATION_KEY=
AI_BRIEF_GENERATION_MODEL=deepseek-chat
AI_ARTICLE_GENERATION_BASE_URL=
AI_ARTICLE_GENERATION_KEY=
AI_ARTICLE_GENERATION_MODEL=deepseek-chat

# SerpApi（可选）
SERPAPI_KEY=

# AI Brief 缓存
AI_BRIEF_CACHE_TTL_MS=600000
AI_BRIEF_CACHE_MAX=50

# 外部 HTTP
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRY_MAX=3
AI_TIMEOUT_SECONDS=90
AI_RETRY_MAX=2

# Shopify Admin API（应用需先安装到店铺，并授予 read_content/write_content）
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Minimal automation loop: execute approved strategy tasks
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_SECONDS=3600
AUTOMATION_BATCH_SIZE=1
AUTOMATION_MIN_IMPRESSIONS=20
