# Copy this file to knowledge/.env and replace every placeholder locally.
# Never commit or paste real passwords into documentation.
KNOWLEDGE_DB_PASSWORD=replace-with-a-long-random-local-password
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://knowledge:replace-with-the-same-url-encoded-password@127.0.0.1:5434/knowledge_system
KNOWLEDGE_API_HOST=127.0.0.1
KNOWLEDGE_API_PORT=8010
KNOWLEDGE_WEB_HOST=127.0.0.1
KNOWLEDGE_WEB_PORT=5174
VITE_KNOWLEDGE_API_URL=http://127.0.0.1:8010

# Optional HTTP(S)/SOCKS5 proxy for public-web crawling, e.g. socks5h://127.0.0.1:7897.
# The backend does not automatically use system proxy settings.
KNOWLEDGE_WEB_PROXY=
KNOWLEDGE_BROWSER_CHANNEL=

# OpenAI-compatible knowledge extraction (backend only; never expose this key to Vite/browser code).
KNOWLEDGE_AI_BASE_URL=https://api.openai-proxy.org/v1
KNOWLEDGE_AI_API_KEY=replace-with-your-closeai-api-key
KNOWLEDGE_AI_MODEL=gpt-5-mini
KNOWLEDGE_AI_TIMEOUT_SECONDS=90
KNOWLEDGE_AI_MAX_ATTEMPTS=2
